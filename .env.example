# ─── Vigie : variables d'environnement (copier en .env, ne jamais committer .env) ───
NODE_ENV=development
DATABASE_URL=postgres://vigie:vigie@localhost:5432/vigie
PUBLIC_URL=http://localhost:4000
APP_SCHEME=vigie
# Clé AES-256 (32 octets, base64) — générer : openssl rand -base64 32
ENCRYPTION_KEY=

# Développement uniquement : code SMS accepté sans envoi réel (interdit en production)
DEV_FIXED_OTP=000000
SMS_PROVIDER=console
# BREVO_API_KEY=

# IA : none | anthropic | vertex (production : vertex, région UE)
AI_PROVIDER=none
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium
# ANTHROPIC_API_KEY=
# VERTEX_PROJECT_ID=
# VERTEX_REGION=europe-west1

# Navigateur isolé (apps/scanner)
# SCANNER_URL=http://localhost:4100
# SCANNER_SECRET=dev-scanner-secret

# Réputation des liens
# WEB_RISK_API_KEY=
# URLHAUS_AUTH_KEY=

# Microsoft Graph (Outlook / Hotmail)
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
MS_TENANT=common
MS_WEBHOOK_SECRET=change-me

# Gmail (flag : audit CASA requis avant activation)
FEATURE_GMAIL=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GMAIL_PUBSUB_TOPIC=projects/<projet>/topics/vigie-gmail
# GMAIL_PUSH_SECRET=

# Notifications push Expo
# EXPO_ACCESS_TOKEN=

# Console banque (Next.js) : URL interne de l'API
VIGIE_API_URL=http://localhost:4000

# Développement uniquement : renvoie le lien d activation client dans l API (QR en console). INTERDIT en production (le serveur refuse de démarrer).
EXPOSE_ACTIVATION_LINK=true
